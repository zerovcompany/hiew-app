# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LINE Login
NEXT_PUBLIC_LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# LINE Messaging API (เปิด Messaging API ให้ LINE Official Account แล้วสร้าง Channel Access Token)
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Channel secret ของ Messaging API channel (ตัว OA) — คนละตัวกับ LINE_CHANNEL_SECRET ด้านบน!
# หาได้ที่ LINE Developers Console > channel ประเภท Messaging API ตัวนี้ > แท็บ Basic settings > Channel secret
# ใช้สำหรับตรวจลายเซ็น (x-line-signature) ตอน LINE ยิง webhook เข้ามา ถ้าใส่ผิดตัว/ใส่ตัวของ Login channel
# แทน จะเจอ error "401 Unauthorized" ตอนกด Verify ใน LINE Developers Console
LINE_MESSAGING_CHANNEL_SECRET=
# URL ของ LINE Official Account (ใช้เป็นลิงก์สำรองสำหรับปุ่มเพิ่มเพื่อน หากต้องการ)
NEXT_PUBLIC_LINE_OA_URL=

# LINE Webhook URL: https://your-domain.com/api/line/webhook
